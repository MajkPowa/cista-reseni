rules_version = '2';

// Čistá řešení — pravidla úložiště fotografií.
// Fotografie referencí jsou veřejně čitelné; nahrávat a mazat smí jen správci.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    match /references/{referenceId}/{fileName} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp|png)');
      allow delete: if isAdmin();
    }
  }
}
