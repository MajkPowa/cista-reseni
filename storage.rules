rules_version = '2';

// Čistá řešení — pravidla úložiště fotografií.
// Fotografie referencí jsou veřejně čitelné; nahrávat a mazat smí jen správci.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.token.email)).data.get('role', 'admin') != 'demo';
    }

    // Přílohy poptávek: návštěvník smí soubor jen jednou nahrát (obrázek nebo PDF do 10 MB),
    // číst a mazat je smí pouze správci.
    match /inquiries/{inquiryId}/{fileName} {
      allow create: if inquiryId.matches('^[A-Za-z0-9]{10,40}$')
        && fileName.matches('^[0-9]-[A-Za-z0-9._-]{1,80}$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
      allow get, list, delete: if isAdmin();
    }

    match /references/{referenceId}/{fileName} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp|png)');
      allow delete: if isAdmin();
    }
  }
}
