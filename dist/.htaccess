# Vygenerováno skriptem scripts/publish_files.py, ručně neupravujte.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType video/mp4 .mp4
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# Stavový soubor nahrávání (production.yml) není pro návštěvníky.
<Files ".ftp-deploy-sync-state.json">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</Files>

<IfModule mod_rewrite.c>
RewriteEngine On
# Jediná adresa webu: https://www.cistareseni.cz/
# (cesta z RewriteRule, ne REQUEST_URI: hosting přes http mapuje web do /www/)
RewriteCond %{HTTP_HOST} ^cistareseni\.cz$ [NC]
RewriteRule ^(.*)$ https://www.cistareseni.cz/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.cistareseni.cz/$1 [R=301,L]
# Úvodní stránka bez index.html
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
# Adresy původního webu
RewriteRule ^produkty-a-sluzby/cerpaci\-sachty\.html$ /sluzby/cerpaci-sachty.html [R=301,L]
RewriteRule ^produkty-a-sluzby/cisteni\-odpadnich\-vod\.html$ /sluzby/cisteni-odpadnich-vod.html [R=301,L]
RewriteRule ^produkty-a-sluzby/cov\-pro\-firmy\-a\-obce\.html$ /sluzby/cov-pro-firmy-a-obce.html [R=301,L]
RewriteRule ^produkty-a-sluzby/hospodareni\-s\-destovou\-vodou\.html$ /sluzby/hospodareni-s-destovou-vodou.html [R=301,L]
RewriteRule ^produkty-a-sluzby/konzultace\-a\-poradenstvi\.html$ /sluzby/konzultace-a-poradenstvi.html [R=301,L]
RewriteRule ^produkty-a-sluzby/montaz\-a\-instalace\-technologii\.html$ /sluzby/montaz-a-instalace-technologii.html [R=301,L]
RewriteRule ^produkty-a-sluzby/prodej\-cov\-a\-destovych\-nadrzi\.html$ /sluzby/prodej-cov-a-destovych-nadrzi.html [R=301,L]
RewriteRule ^produkty-a-sluzby/prodej\-nahradnich\-dilu\.html$ /sluzby/prodej-nahradnich-dilu.html [R=301,L]
RewriteRule ^produkty-a-sluzby/rekonstrukce\-a\-modernizace\-cov\.html$ /sluzby/rekonstrukce-a-modernizace-cov.html [R=301,L]
RewriteRule ^produkty-a-sluzby/servis\-a\-udrzba\.html$ /sluzby/servis-a-udrzba.html [R=301,L]
RewriteRule ^produkty-a-sluzby/skoleni\-obsluhy\-cov\.html$ /sluzby/skoleni-obsluhy-cov.html [R=301,L]
RewriteRule ^produkty-a-sluzby/zajisteni\-povoleni\-stavby\.html$ /sluzby/zajisteni-povoleni-stavby.html [R=301,L]
RewriteRule ^produkty-a-sluzby/zpracovani\-projektove\-dokumentace\.html$ /sluzby/zpracovani-projektove-dokumentace.html [R=301,L]
RewriteRule ^produkty-a-sluzby/zprovozneni\-cov\.html$ /sluzby/zprovozneni-cov.html [R=301,L]
RewriteRule ^produkty-a-sluzby/?$ /sluzby.html [R=301,L]
RewriteRule ^reference/1-[^/]*\.html$ /realizace/1-servisujeme-take-cistirny-asio-vcetne-starsich-typu.html [R=301,L]
