rules_version = '2';

// Čistá řešení — pravidla databáze.
// Veřejnost: čte zveřejněné reference a nastavení webu, smí založit poptávku.
// Správci: ověřený e-mail uvedený v kolekci admins/{e-mail}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.get('role', 'admin');
    }
    function listed() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }
    // Správce: ověřený e-mail na seznamu a jiná role než „demo“.
    function isAdmin() {
      return listed() && request.auth.token.email_verified == true && userRole() != 'demo';
    }
    // Ukázkový účet: vidí jen smyšlená data v kolekcích demo*, k ostrým datům nemá přístup.
    function isDemoUser() {
      return listed() && userRole() == 'demo';
    }

    // ---------- Reference ----------
    match /references/{id} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.published is bool
        && request.resource.data.featured is bool
        && request.resource.data.categories is list
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 60;
      allow delete: if isAdmin();
    }

    // ---------- Poptávky ----------
    function optionalText(data, name, limit) {
      return !data.keys().hasAny([name]) || (data[name] is string && data[name].size() <= limit);
    }
    function validInquiry(data) {
      return data.keys().hasOnly(['service', 'serviceLabel', 'kind', 'program', 'location', 'manufacturer', 'deviceType',
                                  'name', 'email', 'phone', 'message', 'page', 'attachments', 'status', 'createdAt'])
        && data.keys().hasAll(['service', 'serviceLabel', 'location', 'name', 'email', 'status', 'createdAt'])
        // „service“ je v jazyce pravidel vyhrazené slovo, proto zápis s hranatými závorkami.
        && data['service'] in ['cov', 'cov_firmy', 'servis', 'zprovozneni', 'skoleni', 'rekonstrukce',
                            'destovka', 'cerpani', 'poradit', 'upravna', 'komplex', 'pravidelny_servis']
        && data.get('kind', 'realizace') in ['realizace', 'servis', 'pravidelny']
        && data.get('program', 'standard') in ['standard', 'premium']
        && data.get('attachments', []) is list && data.get('attachments', []).size() <= 5
        && data.serviceLabel is string && data.serviceLabel.size() <= 80
        && data.location is string && data.location.size() > 0 && data.location.size() <= 120
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 200
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && optionalText(data, 'manufacturer', 120)
        && optionalText(data, 'deviceType', 160)
        && optionalText(data, 'phone', 40)
        && optionalText(data, 'message', 2000)
        && optionalText(data, 'page', 200)
        && data.status == 'new'
        && data.createdAt == request.time;
    }
    match /inquiries/{id} {
      allow create: if validInquiry(request.resource.data);
      allow get, list: if isAdmin();
      // Správce mění jen stav a interní údaje; text od zákazníka zůstává beze změny.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'in_progress', 'quoted', 'won', 'closed'];
      allow delete: if isAdmin();
    }

    // ---------- Nastavení webu (kategorie) ----------
    match /settings/{name} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // ---------- Správci ----------
    match /admins/{email} {
      // Přihlášený uživatel smí zjistit, zda je na seznamu on sám.
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower() && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      // Správce nemůže odebrat sám sebe, aby administrace nezůstala bez přístupu.
      allow delete: if isAdmin() && request.auth.token.email != email;
    }

    // ---------- CRM: zákazníci, zařízení, zakázky, úkoly, historie ----------
    match /customers/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200;
    }
    match /devices/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.customerId is string && request.resource.data.customerId.size() > 0;
    }
    match /jobs/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.stage in ['lead', 'quote', 'scheduled', 'done', 'invoiced', 'lost'];
    }
    match /tasks/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.done is bool;
    }
    match /activities/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.customerId is string
        && request.resource.data.text is string && request.resource.data.text.size() > 0;
    }

    // ---------- Ukázkový režim CRM: oddělená smyšlená data ----------
    match /{demoCollection}/{id} {
      allow read, write: if demoCollection in ['demoCustomers', 'demoDevices', 'demoJobs', 'demoTasks', 'demoActivities', 'demoInquiries']
        && (isAdmin() || isDemoUser());
    }

    // ---------- Návštěvnost: anonymní denní počitadla bez cookies ----------
    // Veřejnost smí jen přičíst jedničku k povoleným počitadlům; číst smí správci.
    function counterStep(after, before, name) {
      return after.get(name, 0) - before.get(name, 0) in [0, 1];
    }
    function validCounters(after, before) {
      return after.keys().hasOnly(['views', 'visits', 'home', 'sluzby', 'servis', 'reference', 'realizace', 'kontakt', 'ostatni'])
        && counterStep(after, before, 'views') && counterStep(after, before, 'visits') && counterStep(after, before, 'home')
        && counterStep(after, before, 'sluzby') && counterStep(after, before, 'servis') && counterStep(after, before, 'reference')
        && counterStep(after, before, 'realizace') && counterStep(after, before, 'kontakt') && counterStep(after, before, 'ostatni');
    }
    match /stats/{day} {
      allow get, list: if isAdmin();
      allow create: if day.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$') && validCounters(request.resource.data, {});
      allow update: if validCounters(request.resource.data, resource.data);
    }

    // Vše ostatní (např. system/* pro Cloud Functions) je klientům uzavřené.
  }
}
